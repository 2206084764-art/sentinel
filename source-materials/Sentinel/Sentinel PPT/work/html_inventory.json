      "function start(){",
      "function setMode(m){",
      "function postState(){ try{parent.postMessage({type:'runner-state',running:running,path:currentPath},'*');}catch(_){} }",
      "function startPath(name){",
      "  applyRunPose(0); postState(); try{parent.postMessage({type:'runner-red',red:false},'*');}catch(_){}",
      "function toggleWander(){ if(!started) return; if(currentPath!=='Wandering'){ startPath('Wandering'); } else { running=!running; postState(); } }",
      "function toggleSteal(){ if(!started) return; if(currentPath!=='Stealing'){ startPath('Stealing'); } else { running=!running; postState(); } }",
      "function setWireframe(on){ wireMode=on; [truckPaint,truckGlass,sentMat,manMat,fuelMat].forEach(m=>{ if(m) m.wireframe=on; }); }",
      "window.addEventListener('keydown',e=>{",
      "  if(e.key==='r'||e.key==='R'){ e.preventDefault(); toggleWander(); }",
      "  else if(e.key==='t'||e.key==='T'){ e.preventDefault(); toggleSteal(); }",
      "  else if(e.key==='s'||e.key==='S'){ e.preventDefault(); setWireframe(!wireMode); }",
      "  else if(['ArrowRight','ArrowLeft','ArrowUp','ArrowDown','PageUp','PageDown',' '].includes(e.key)){",
      "    const dir=['ArrowLeft','ArrowUp','PageUp'].includes(e.key)?'prev':'next';",
      "    try{ parent.postMessage({type:'deck-nav',dir:dir},'*'); }catch(_){}",
      "window.addEventListener('message',e=>{ const d=e.data||{};",
      "  if(red && currentPath==='Stealing' && !stealAlerted){ stealAlerted=true; try{parent.postMessage({type:'runner-red',red:true},'*');}catch(_){} }"
    ]
  },
